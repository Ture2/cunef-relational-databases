<mxCell id="o2" value="(0,N)" style="endArrow=none;html=1;" edge="1" parent="1" source="acc" target="r1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="b1" style="endArrow=none;html=1;" edge="1" parent="1" source="acc" target="r2"><mxGeometry relative="1" as="geometry"/></mxCell>
